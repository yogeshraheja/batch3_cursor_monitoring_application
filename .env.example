# Copy to .env and fill in local values. Never commit .env.

# Flask session signing key (required outside demo mode)
SECRET_KEY=replace-with-long-random-string

# Admin password for first-run seed (hashed in SQLite). Must be strong —
# placeholders and weak values are refused. Not hard-coded in the repo.
ADMIN_PASSWORD=replace-with-strong-local-password

# demo = allow ephemeral SECRET_KEY with a warning if unset
# anything else = fail startup if SECRET_KEY is missing
APP_ENV=demo

# Optional SQLite URL (default: sqlite:////<project>/instance/monitoring.db)
# DATABASE_URL=sqlite:////tmp/monitoring-demo.db

# Optional SSH / login tuning
# SSH_CONNECT_TIMEOUT=8
# SSH_COMMAND_TIMEOUT=8
# SSH_STRICT_HOST_KEYS=0
# LOGIN_FAILURE_DELAY_SECONDS=0.4
