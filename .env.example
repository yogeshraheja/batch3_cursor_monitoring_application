# Copy to .env and fill in local values. Never commit .env.

# Flask session signing key (required outside demo mode)
SECRET_KEY=change-me-to-a-long-random-string

# Admin password used later for seeding the hashed admin user (Phase 1+)
ADMIN_PASSWORD=change-me-strong-password

# demo = allow ephemeral SECRET_KEY with a warning if unset
# anything else = fail startup if SECRET_KEY is missing
APP_ENV=demo
